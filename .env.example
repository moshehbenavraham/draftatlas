# ARCH STUDIO — environment variables
#
# Copy this file to `.env.local` and fill in real values. None of these are
# required to run the site; when unset the forms fall back to opening a
# prefilled mailto: draft so visitor intent isn't silently dropped.
#
# Vite only exposes vars prefixed with VITE_ to client code. All values here
# end up in the production bundle, so don't put secrets here.

# Public-facing email shown in the studio footer / contact details and used
# as the recipient for the mailto: fallback. Defaults to hello@archstudio.com.
VITE_CONTACT_EMAIL="hello@archstudio.com"

# Optional POST endpoint for newsletter signups. Expected payload:
#   { "email": "you@example.com", "source": "/blog" }
# Expected to respond 200/201 on success, any non-2xx is treated as failure.
# Examples: Formspree, ConvertKit's webhook, Resend Audiences, a custom Worker.
# VITE_NEWSLETTER_ENDPOINT="https://example.com/api/newsletter"

# Optional POST endpoint for contact-form submissions. Expected payload:
#   { "name": "...", "email": "...", "subject": "...", "message": "...", "source": "..." }
# Expected to respond 200/201 on success.
# VITE_CONTACT_FORM_ENDPOINT="https://example.com/api/contact"
